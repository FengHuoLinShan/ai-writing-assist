{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "echo '{\"systemMessage\": \"git commit 已提交。需要同步更新设计文档（CLAUDE.md / docs/）吗？如需，请告诉我需要修改什么。\", \"continue\": true}'",
            "timeout": 5,
            "statusMessage": "询问是否更新文档…"
          }
        ]
      }
    ]
  }
}
