{
  "id": "phase2_world_extraction",
  "version": 1,
  "owner": "imports",
  "schema_model": "modules.imports.llm_schemas.Phase2WorldExtractionOutput",
  "declared_prompt_fields": [
    "objects",
    "relations",
    "deltas",
    "uncertain_items"
  ],
  "forbidden_fields": ["status"],
  "required_evidence_field": "supporting_scene_ids",
  "strict_schema_coverage": true,
  "required_mappings": [
    {"source": "objects.name", "target": "core_entities.name"},
    {"source": "objects.entity_type", "target": "core_entities.entity_type"},
    {"source": "objects.summary", "target": "core_entities.summary"},
    {"source": "objects.aliases", "target": "core_entities.content_json.aliases"},
    {"source": "relations.relation_type", "target": "entity_relations.relation_type"},
    {"source": "relations.description", "target": "entity_relations.description"},
    {"source": "deltas.category", "target": "delta_log.category"},
    {"source": "deltas.field", "target": "delta_log.field_path"},
    {"source": "deltas.subject_name", "target": "core_entities.name"}
  ],
  "observed_fields": [
    "objects.confidence",
    "relations.confidence",
    "deltas.confidence"
  ],
  "ignored_fields": [
    {"source": "uncertain_items", "reason": "diagnostics only"}
  ],
  "probes": []
}
