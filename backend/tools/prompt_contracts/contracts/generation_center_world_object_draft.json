{
  "id": "generation_center_world_object_draft",
  "version": 1,
  "owner": "world",
  "schema_model": "modules.world.llm_schemas.GeneratedObjectDraftOutput",
  "declared_prompt_fields": [
    "name",
    "summary",
    "public_info",
    "hidden_truth",
    "importance_level",
    "reveal_level",
    "details",
    "character_card"
  ],
  "forbidden_fields": ["status", "approved_by", "novel_id", "id"],
  "required_evidence_field": null,
  "strict_schema_coverage": false,
  "required_mappings": [
    {"source": "name", "target": "core_entities.name"},
    {"source": "summary", "target": "core_entities.summary"},
    {"source": "public_info", "target": "core_entities.public_info"},
    {"source": "hidden_truth", "target": "core_entities.hidden_truth"},
    {"source": "details", "target": "core_entities.content_json.details"},
    {"source": "character_card", "target": "core_entities.content_json.character_card"}
  ],
  "observed_fields": ["importance_level", "reveal_level"],
  "ignored_fields": [],
  "probes": [
    "generation_center_builtin_templates_validate",
    "generation_center_frontend_template_options_match",
    "generation_center_docs_commands_present"
  ]
}
