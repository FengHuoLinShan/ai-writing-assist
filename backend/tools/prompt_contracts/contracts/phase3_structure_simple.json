{
  "id": "phase3_structure_simple",
  "version": 2,
  "owner": "outline",
  "schema_model": "modules.story.outline_state.generation.models.SimpleStructureOutput",
  "declared_prompt_fields": [
    "plot_threads",
    "arcs",
    "foreshadowing",
    "reveals",
    "turning_points",
    "uncertain_items"
  ],
  "forbidden_fields": ["status"],
  "required_evidence_field": "supporting_scene_ids",
  "strict_schema_coverage": false,
  "required_mappings": [
    {"source": "plot_threads.title", "target": "plot_threads.name"},
    {"source": "plot_threads.thread_type", "target": "plot_threads.thread_type"},
    {"source": "plot_threads.current_stage", "target": "plot_threads.current_stage"},
    {"source": "arcs.title", "target": "outline_arcs.title"},
    {"source": "arcs.summary", "target": "outline_arcs.arc_goal"},
    {"source": "foreshadowing.title", "target": "foreshadowing_plans.name"},
    {"source": "foreshadowing.summary", "target": "foreshadowing_plans.summary"},
    {"source": "reveals.title", "target": "reveal_plans.target_id"},
    {"source": "reveals.summary", "target": "reveal_plans.secret_summary"}
  ],
  "observed_fields": [
    "plot_threads.confidence",
    "arcs.confidence",
    "foreshadowing.confidence",
    "reveals.confidence",
    "turning_points.confidence"
  ],
  "ignored_fields": [
    {"source": "turning_points", "reason": "stored in parser diagnostics"},
    {"source": "uncertain_items", "reason": "diagnostics only"}
  ],
  "probes": []
}
