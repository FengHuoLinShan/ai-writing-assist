# ============================================================
# AI 长篇小说结构化创作引擎 — 环境配置示例
# ============================================================

# 数据库连接（Docker Compose 默认配置）
DATABASE_URL=postgresql+asyncpg://novelist:novel_dev_pass@localhost:5207/ai_novel_engine

# LLM 运行参数
# 业务 LLM 供应商、Base URL、模型和 API Key 只通过前端项目/全局设置页配置；
# LLM_API_KEY / LLM_BASE_URL / LLM_MODEL 不再作为业务调用 fallback。
LLM_TRUST_ENV=false
# 公开模式如需自定义 OpenAI-compatible Base URL，必须配置这个显式出站代理；
# LLM_TRUST_ENV 不构成私网隔离边界。
LLM_PROXY_URL=
LLM_HEALTH_REQUIRED=true
LLM_RETRY_MAX_ATTEMPTS=3
LLM_RETRY_BASE_DELAY=1.0
LLM_RETRY_MAX_DELAY=60.0
LLM_MAX_CONCURRENT_REQUESTS=8
# 本地可设为 0；非 development/test/local 环境必须按 provider 配额配置正 RPM。
# 该限制按进程执行；API 与 task worker 的实例数会共同放大总吞吐。
LLM_RATE_LIMIT_PER_MINUTE=0
LLM_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
LLM_CIRCUIT_BREAKER_RESET_SECONDS=60.0

# AI 地图册私有对象存储。可使用 AWS S3 或兼容服务；留空 endpoint 使用 AWS 默认地址。
MAP_ATLAS_S3_BUCKET=
MAP_ATLAS_S3_REGION=us-east-1
MAP_ATLAS_S3_ENDPOINT_URL=
MAP_ATLAS_S3_ACCESS_KEY_ID=
MAP_ATLAS_S3_SECRET_ACCESS_KEY=
MAP_ATLAS_S3_FORCE_PATH_STYLE=false

# 应用配置
DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
# local / closed_test / public
AUTH_MODE=local
# 仅 closed_test 在非本地环境使用共享访问令牌。
APP_ACCESS_TOKEN=
# public 必填；至少 32 字符，用于会话、CSRF、邮箱和验证码 keyed HMAC。
AUTH_SECRET_KEY=
PUBLIC_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=*

# 公开邮箱验证码（使用新建的专用邮箱，不要使用日常私人邮箱）
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TIMEOUT_SECONDS=10
SUPPORT_EMAIL=
TERMS_VERSION=2026-07-23
PRIVACY_VERSION=2026-07-23

# Authing 托管微信登录；完成 Authing + 微信开放平台真实扫码前保持 false
AUTHING_WECHAT_ENABLED=false
AUTHING_ISSUER=
AUTHING_CLIENT_ID=
AUTHING_CLIENT_SECRET=
AUTHING_REDIRECT_URI=
# 本地可设为 0；非 development/test/local 环境必须配置正 RPM。
# 该限制按 direct peer、每进程执行；多 worker 部署需按进程数拆分总配额。
HTTP_RATE_LIMIT_PER_MINUTE=0
HTTP_RATE_LIMIT_BURST=60
HTTP_RATE_LIMIT_MAX_CLIENTS=10000
# Fernet key，用于加密项目级 LLM API Key。生成方式：
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LLM_SETTINGS_ENCRYPTION_KEY=

# Embedding 维度（默认 768，匹配 bge-base-zh-v1.5 与 rag_chunks 向量列）
EMBEDDING_DIM=768
RAG_PREWARM_ON_STARTUP=false
EMBEDDING_BATCH_QUEUE_DELAY_MS=5
EMBEDDING_BATCH_QUEUE_MAX_ITEMS=64
EMBEDDING_BATCH_QUEUE_TIMEOUT_SECONDS=30.0
INFERENCE_WORKER_STARTUP_TIMEOUT=300.0
# 检索 LLM Planner 与证据重排均需先通过冻结评测再显式开启。
RAG_QUERY_PLANNER_ENABLED=false
RERANKER_ENABLED=false

# 后台任务 worker
TASK_WORKER_MAX_CONCURRENT_TASKS=2

# 文件/深度导入单次最大章节数
IMPORT_MAX_CHAPTERS=1000

# 日志级别
LOG_LEVEL=INFO
