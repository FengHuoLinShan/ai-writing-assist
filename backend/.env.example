# ============================================================
# AI 长篇小说结构化创作引擎 — 环境配置示例
# ============================================================

# 数据库连接（Docker Compose 默认配置）
DATABASE_URL=postgresql+asyncpg://novelist:novel_dev_pass@localhost:5207/ai_novel_engine

# LLM 运行参数
# 业务 LLM 供应商、Base URL、模型和 API Key 只通过前端项目/全局设置页配置；
# LLM_API_KEY / LLM_BASE_URL / LLM_MODEL 不再作为业务调用 fallback。
LLM_TRUST_ENV=false
LLM_PROXY_URL=
LLM_HEALTH_REQUIRED=true
LLM_RETRY_MAX_ATTEMPTS=3
LLM_RETRY_BASE_DELAY=1.0
LLM_RETRY_MAX_DELAY=60.0
LLM_MAX_CONCURRENT_REQUESTS=8
# 本地可设为 0；非 development/test/local 环境必须按 provider 配额配置正 RPM。
# 该限制按进程执行；API 与 task worker 的实例数会共同放大总吞吐。
LLM_RATE_LIMIT_PER_MINUTE=0
LLM_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
LLM_CIRCUIT_BREAKER_RESET_SECONDS=60.0

# 应用配置
DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
# 非 development/test/local 环境必须配置，用于封闭测试服访问闸门。
APP_ACCESS_TOKEN=
# 本地可设为 0；非 development/test/local 环境必须配置正 RPM。
# 该限制按 direct peer、每进程执行；多 worker 部署需按进程数拆分总配额。
HTTP_RATE_LIMIT_PER_MINUTE=0
HTTP_RATE_LIMIT_BURST=60
HTTP_RATE_LIMIT_MAX_CLIENTS=10000
# Fernet key，用于加密项目级 LLM API Key。生成方式：
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LLM_SETTINGS_ENCRYPTION_KEY=

# Embedding 维度（默认 768，匹配 bge-base-zh-v1.5 与 rag_chunks 向量列）
EMBEDDING_DIM=768
RAG_PREWARM_ON_STARTUP=false
EMBEDDING_BATCH_QUEUE_DELAY_MS=5
EMBEDDING_BATCH_QUEUE_MAX_ITEMS=64
EMBEDDING_BATCH_QUEUE_TIMEOUT_SECONDS=30.0

# 后台任务 worker
TASK_WORKER_MAX_CONCURRENT_TASKS=2

# 文件/深度导入单次最大章节数
IMPORT_MAX_CHAPTERS=1000

# 日志级别
LOG_LEVEL=INFO
