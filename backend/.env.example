# ============================================================
# AI 长篇小说结构化创作引擎 — 环境配置示例
# ============================================================

# 数据库连接（Docker Compose 默认配置）
DATABASE_URL=postgresql+asyncpg://novelist:novel_dev_pass@localhost:5207/ai_novel_engine

# LLM 服务配置
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=deepseek-v4-flash

# 应用配置
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Embedding 维度（默认 1024）
EMBEDDING_DIM=1024

# 日志级别
LOG_LEVEL=INFO
