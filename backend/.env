# ============================================================
# AI 长篇小说结构化创作引擎 — 开发环境配置
# ============================================================

# 数据库连接（Docker Compose 默认配置）
DATABASE_URL=postgresql+asyncpg://novelist:novel_dev_pass@localhost:5432/ai_novel_engine

# LLM 服务配置（使用 OpenAI 兼容 API）
LLM_API_KEY=sk-placeholder
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# 应用配置
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# Embedding 维度
EMBEDDING_DIM=1024

# 日志级别
LOG_LEVEL=DEBUG
