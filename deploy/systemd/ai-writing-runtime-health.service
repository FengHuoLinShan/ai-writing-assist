[Unit]
Description=AI Writing Assist runtime health check
Requires=docker.service
After=docker.service
Wants=network-online.target
After=network-online.target
ConditionPathExists=/opt/ai-writing-assist/deploy/.env.production

[Service]
Type=oneshot
WorkingDirectory=/opt/ai-writing-assist
Environment=ENV_FILE=/opt/ai-writing-assist/deploy/.env.production
ExecStart=/bin/bash /opt/ai-writing-assist/deploy/scripts/runtime_health.sh
TimeoutStartSec=5m
