[Unit]
Description=AI Writing Assist PostgreSQL backup
Requires=docker.service
Wants=network-online.target
After=docker.service network-online.target
ConditionPathExists=/opt/ai-writing-assist/deploy/.env.production

[Service]
Type=oneshot
WorkingDirectory=/opt/ai-writing-assist
Environment=ENV_FILE=/opt/ai-writing-assist/deploy/.env.production
ExecStart=/bin/bash /opt/ai-writing-assist/deploy/scripts/backup.sh
TimeoutStartSec=4h
TimeoutStopSec=2m
KillMode=control-group
