# Copy to deploy/.env.production. The real file is gitignored.
#
# Values beginning with CHANGE_ME are deliberate decision gates. The validation
# script refuses to deploy while any required placeholder remains.

# Release and database
POSTGRES_IMAGE=docker.m.daocloud.io/pgvector/pgvector:0.8.6-pg17-bookworm@sha256:7ae6051efd0e60444282c27c7e141af07f322ce033300e727a49c3dd11075e38
POSTGRES_DB=ai_writing_assist
POSTGRES_USER=ai_writing_assist
DATABASE_MODE=fresh
# URL-safe characters only; generate a new random value for production.
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_DATABASE_PASSWORD
POOL_SIZE=10
MAX_OVERFLOW=20

# Public address and access mode
DEPLOY_DOMAIN=novel.zhh.se
PUBLIC_BASE_URL=https://novel.zhh.se
ALLOWED_ORIGINS=https://novel.zhh.se
AUTH_MODE=public

# closed_test only: generate at least 32 random characters.
APP_ACCESS_TOKEN=

# public only: generate at least 32 random characters.
AUTH_SECRET_KEY=CHANGE_ME_IF_PUBLIC
# The private production owner claims migrated bootstrap projects before public
# API startup. Keep all owner and mail values only in the mode-0600 env file.
BOOTSTRAP_OWNER_EMAIL=CHANGE_ME_BOOTSTRAP_OWNER_EMAIL
SMTP_HOST=CHANGE_ME_SMTP_HOST
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_USERNAME=CHANGE_ME_SMTP_USERNAME
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM=CHANGE_ME_SMTP_FROM
SMTP_TIMEOUT_SECONDS=10
SUPPORT_EMAIL=CHANGE_ME_SUPPORT_EMAIL
TERMS_VERSION=2026-07-23
PRIVACY_VERSION=2026-07-23

# Keep disabled until Authing and real WeChat QR-code smoke tests pass.
AUTHING_WECHAT_ENABLED=false
AUTHING_ISSUER=
AUTHING_CLIENT_ID=
AUTHING_CLIENT_SECRET=
AUTHING_REDIRECT_URI=

# Production safety and throughput
HTTP_RATE_LIMIT_PER_MINUTE=120
HTTP_RATE_LIMIT_BURST=30
HTTP_RATE_LIMIT_MAX_CLIENTS=10000
# Users supply their own project LLM configuration; 0 disables an extra global RPM.
LLM_RATE_LIMIT_PER_MINUTE=0
LLM_MAX_CONCURRENT_REQUESTS=4
TASK_WORKER_MAX_CONCURRENT_TASKS=1
LOG_LEVEL=INFO

# Generate a Fernet key; never reuse the local development key.
LLM_SETTINGS_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY
LLM_TRUST_ENV=false
LLM_PROXY_URL=
LLM_HEALTH_REQUIRED=true

# 单盘 MinIO 私有图片存储。两个桶的硬配额合计 32GiB：地图册 8GiB、世界对象 24GiB。
# 使用锁定镜像，API/管理控制台均不在生产主机发布端口。
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z@sha256:a1ea29fa28355559ef137d71fc570e508a214ec84ff8083e39bc5428980b015e
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-03-12T17-29-24Z@sha256:470f5546b596e16c7816b9c3fa7a78ce4076bb73c2c73f7faeec0c8043923123
MAP_ATLAS_S3_BUCKET=CHANGE_ME_PRIVATE_MAP_ATLAS_BUCKET
WORLD_OBJECT_S3_BUCKET=CHANGE_ME_PRIVATE_WORLD_OBJECT_BUCKET
MAP_ATLAS_S3_REGION=us-east-1
MAP_ATLAS_S3_ENDPOINT_URL=http://minio:9000
# Root credentials go only to MinIO and the one-shot initializer; do not reuse
# them below. The app user gets a policy limited to the two buckets.
MINIO_ROOT_USER=CHANGE_ME_MINIO_ROOT_USER
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT_PASSWORD
MAP_ATLAS_S3_ACCESS_KEY_ID=CHANGE_ME_MINIO_APP_ACCESS_KEY
MAP_ATLAS_S3_SECRET_ACCESS_KEY=CHANGE_ME_MINIO_APP_SECRET_KEY
MAP_ATLAS_S3_FORCE_PATH_STYLE=true

# Local CPU embedding service. It is reachable only from the Docker egress
# network and exposes the OpenAI-compatible API expected by the application.
EMBEDDING_DEPLOYMENT=local_tei
EMBEDDING_IMAGE=ghcr.io/huggingface/text-embeddings-inference:cpu-1.9@sha256:c26a226262ad4ff3330fb30b76653c1bb65da2fcf413b92284545a010e0a8a48
EMBEDDING_MODEL_ID=BAAI/bge-base-zh-v1.5
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=bge-base-zh-v1.5
EMBEDDING_BASE_URL=http://embedding:80/v1
EMBEDDING_API_KEY=local-tei-internal
EMBEDDING_DIM=768
EMBEDDING_MAX_CONCURRENT_REQUESTS=16
RAG_PREWARM_ON_STARTUP=false

# Operations
BACKUP_RETENTION_DAYS=30
OPENRESTY_CONTAINER=OpenResty
OPENRESTY_TUNNEL_PORT=3259
API_LOOPBACK_PORT=18000
FRONTEND_LOOPBACK_PORT=18080

# Encrypted off-site backup. Create a private Backblaze B2 bucket and an
# application key limited to that bucket, then initialize the restic repository.
OFFSITE_BACKUP_PROVIDER=backblaze_b2
RESTIC_REPOSITORY=b2:CHANGE_ME_PRIVATE_BUCKET:ai-writing-assist
B2_ACCOUNT_ID=CHANGE_ME_B2_APPLICATION_KEY_ID
B2_ACCOUNT_KEY=CHANGE_ME_B2_APPLICATION_KEY
RESTIC_PASSWORD=CHANGE_ME_RESTIC_REPOSITORY_PASSWORD

# Create three Healthchecks.io checks and configure private alert recipients.
# Ping URLs are secrets and stay only in the mode-0600 .env.production file.
HEALTHCHECKS_BACKUP_PING_URL=CHANGE_ME_HEALTHCHECKS_BACKUP_PING_URL
HEALTHCHECKS_MAINTENANCE_PING_URL=CHANGE_ME_HEALTHCHECKS_MAINTENANCE_PING_URL
HEALTHCHECKS_RUNTIME_PING_URL=CHANGE_ME_HEALTHCHECKS_RUNTIME_PING_URL
