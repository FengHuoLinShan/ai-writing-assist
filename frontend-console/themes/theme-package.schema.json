{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NovelCraft ThemePackageV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "variants"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$",
      "not": {
        "const": "modern"
      }
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "variants": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "light": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "colors": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "background": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "surface": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "muted": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "text": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "body": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "secondary": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "accent": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "onAccent": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "primary": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "onPrimary": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "border": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "controlBorder": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "success": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "warning": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "danger": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                }
              }
            },
            "radius": {
              "type": "integer",
              "minimum": 0,
              "maximum": 16
            },
            "density": {
              "enum": [
                "comfortable",
                "compact"
              ]
            },
            "shadow": {
              "enum": [
                "none",
                "soft"
              ]
            },
            "uiFont": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "bodyFont": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "background": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "texture": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "emptyState": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            }
          }
        },
        "dark": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "colors": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "background": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "surface": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "muted": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "text": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "body": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "secondary": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "accent": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "onAccent": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "primary": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "onPrimary": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "border": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "controlBorder": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "success": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "warning": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "danger": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                }
              }
            },
            "radius": {
              "type": "integer",
              "minimum": 0,
              "maximum": 16
            },
            "density": {
              "enum": [
                "comfortable",
                "compact"
              ]
            },
            "shadow": {
              "enum": [
                "none",
                "soft"
              ]
            },
            "uiFont": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "bodyFont": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "background": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "texture": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "emptyState": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            }
          }
        }
      }
    },
    "assets": {
      "type": "object",
      "maxProperties": 127,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$",
        "not": {
          "enum": [
            "constructor",
            "prototype"
          ]
        }
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "kind"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^assets/[A-Za-z0-9_./-]+$"
          },
          "kind": {
            "enum": [
              "image",
              "font"
            ]
          },
          "weight": {
            "type": "integer",
            "minimum": 100,
            "maximum": 900
          },
          "style": {
            "enum": [
              "normal",
              "italic"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "font"
                }
              }
            },
            "then": {
              "properties": {
                "path": {
                  "pattern": "\\.woff2$"
                }
              }
            },
            "else": {
              "properties": {
                "path": {
                  "pattern": "\\.(png|jpe?g|webp)$"
                }
              },
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "weight"
                    ]
                  },
                  {
                    "required": [
                      "style"
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    }
  },
  "$comment": "The runtime additionally checks unique normalized paths, binary content, expansion budgets, dimensions, asset references and contrast."
}
