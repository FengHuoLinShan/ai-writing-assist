{
  "name": "frontend-console",
  "version": "1.0.0",
  "description": "AI 小说创作控制台",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port ${FRONTEND_PORT:-8080} --strictPort",
    "build": "vite build && node scripts/verify-production-build.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:functional": "playwright test --config=playwright.functional.config.js",
    "test:e2e:smoke": "playwright test --config=playwright.functional.config.js e2e/home.spec.js e2e/project.spec.js e2e/import.spec.js e2e/writing.spec.js",
    "test:e2e:visual": "playwright test --config=playwright.visual.config.js",
    "test:e2e:visual:update": "playwright test --config=playwright.visual.config.js --update-snapshots",
    "test:e2e:map": "playwright test --config=playwright.functional.config.js map-atlas.spec.js --workers=1 --retries=0",
    "test:e2e:real-llm": "ENABLE_REAL_LLM=1 playwright test --config=playwright.real-llm.config.js",
    "test:e2e:worker": "RUN_WORKER_E2E=1 playwright test --config=playwright.worker.config.js",
    "test:e2e:ui": "playwright test --config=playwright.functional.config.js --ui"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "happy-dom": "^20.12.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "vue": "^3.5.42"
  }
}
