    "author-boundary": {
      "instruction": "完善潮门维护轮值，但作者已经否定复活死者和活体传送；任何方案都不得把这两项重新包装成例外。",
      "checkpoint_overrides": {}
    },
    "goal-misread": {
      "instruction": "只补足潮门的七日盐料储备与断供后的降级运转；不得扩建新港、不得改变潮门不能运送生命的限制。",
      "checkpoint_overrides": {}
    },
    "information-flow": {
      "instruction": "设计潮门故障告警链：谁先发现、谁能确认、消息如何到港务厅与船队，并保留谣言和延迟造成的误判。",
      "checkpoint_overrides": {}
    },
    "institution-enforcement": {
      "instruction": "补足潮门盐料配给制度的执行者、审计、违规收益、处罚和申诉路径，不要只写一条无人执行的法令。",
      "checkpoint_overrides": {}
    },
    "insufficient-evidence": {
      "instruction": "有人声称北岸盐矿足够供应百年，但当前资料没有产量、运输或储量证据。请保持为待核假设，不要当成事实，也不要擅自判定它错误。",
      "checkpoint_overrides": {}
    },
    "long-feedback": {
      "instruction": "推演潮门盐料垄断持续三年后对价格、走私、维修人才和港口权力结构的反馈，不把短期结果直接写成永久结论。",
      "checkpoint_overrides": {}
    },
    "maintenance-failure": {
      "instruction": "推演潮门夜班维护者缺席、备件受潮和错误维修同时发生时的可见症状、处置顺序与残余后果。",
      "checkpoint_overrides": {}
    },
    "no-issue": {
      "instruction": "已确定潮门有七日盐料、双人轮值、机械旁路和公开故障告警。只整理这些内容，不要制造新的问题或要求作者重复决定。",
      "checkpoint_overrides": {
